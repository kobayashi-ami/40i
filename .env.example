# Copy to .env (gitignored). Defaults match compose.yaml.
DATABASE_URL=postgresql+psycopg://1260:1260@127.0.0.1:55432/1260
REDIS_URL=redis://127.0.0.1:56379/0
DATA_DIR=./data
API_HOST=127.0.0.1
API_PORT=8260
# Worker liveness: heartbeat every HEARTBEAT_S, considered dead after HEARTBEAT_TTL_S.
HEARTBEAT_S=5
HEARTBEAT_TTL_S=15
# A job whose worker died is re-queued until it has run MAX_ATTEMPTS times, then marked failed.
MAX_ATTEMPTS=3
